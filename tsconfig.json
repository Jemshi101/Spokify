{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // onnxruntime-web's "exports" hide its types.d.ts from TypeScript.
    "paths": { "onnxruntime-web": ["./node_modules/onnxruntime-web/types.d.ts"] }
  },
  "include": ["src", "tests/unit"]
}
