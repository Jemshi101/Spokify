{
  "manifest_version": 3,
  "name": "Spokify",
  "version": "0.6.1",
  "description": "Reads web pages aloud with natural voices that run locally (Kokoro). Read-along highlighting, background play.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Spokify",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "read-page": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Read the current page"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause / resume"
    },
    "next-sentence": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "Next sentence"
    },
    "prev-sentence": {
      "suggested_key": {
        "default": "Alt+Shift+Comma"
      },
      "description": "Previous sentence"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "128",
  "key": ""
}
